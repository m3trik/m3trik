{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "-I", "${CLAUDE_PLUGIN_ROOT}/skills/challenge/usage_gate.py", "--hook"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
