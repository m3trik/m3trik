{
  "mcpServers": {
    "ops": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=2.3,<3",
        "python",
        "-m",
        "pythontk",
        "ops",
        "mcp"
      ]
    },
    "ops-apply": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=2.3,<3",
        "python",
        "-m",
        "pythontk",
        "ops",
        "mcp",
        "--apply"
      ]
    }
  }
}
