{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "-I", "${CLAUDE_PLUGIN_ROOT}/hooks/hooks.py", "session-start"],
            "timeout": 15,
            "statusMessage": "Checking deferred-issue backlog"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "-I", "${CLAUDE_PLUGIN_ROOT}/hooks/hooks.py", "edit"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "-I", "${CLAUDE_PLUGIN_ROOT}/hooks/hooks.py", "stop", "--budget", "60"],
            "timeout": 90,
            "statusMessage": "Checking the turn's changes (lint, affected tests)"
          }
        ]
      }
    ]
  }
}
